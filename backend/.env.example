# Modelo de configuração do back-end.
# Copie este arquivo para ".env" e ajuste os valores (o ".env" NÃO vai pro GitHub).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=grao_nobre
PORT=3000

# Chave secreta que assina o token de login (JWT).
# Preencha com um texto grande e aleatório (mínimo 16 caracteres). O servidor não liga sem ela.
JWT_SECRET=

# (Opcional) Sites que podem chamar a API pelo navegador, separados por vírgula.
# Sem isso valem localhost e 127.0.0.1 nas portas 5173 (dev), 4173 (preview) e 8080 (Docker).
# CORS_ORIGIN=http://localhost:5173
