# Modelo de configuração do back-end.
# Copie este arquivo para ".env" e ajuste os valores (o ".env" NÃO vai pro GitHub).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=grao_nobre
PORT=3000

# Chave secreta que assina o token de login (JWT).
# Preencha com um texto grande e aleatório (mínimo 16 caracteres). O servidor não liga sem ela.
JWT_SECRET=
