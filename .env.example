# Modelo de configuração do Docker (docker compose).
# Copie este arquivo para ".env" e preencha os dois valores (o ".env" NÃO vai pro GitHub).

# Senha do usuário do banco (invente uma)
DB_PASSWORD=

# Chave secreta que assina o token de login (JWT): texto grande e aleatório, mínimo 16 caracteres
JWT_SECRET=
